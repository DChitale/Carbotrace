# Environment Configuration Example
ENV=development
DEBUG=true

# Database
# Use postgresql+asyncpg for SQLAlchemy async operations
# For running inside docker-compose, use: postgresql+asyncpg://postgres:postgres@db:5432/carbotrace
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/carbotrace
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carbotrace

# Database Credentials (for docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=carbotrace

# Integrations (Optional for basic running, required for real analysis/real-time stats)
# GITHUB_TOKEN=your_github_personal_access_token
# ELECTRICITY_MAPS_API_KEY=your_electricity_maps_api_key

# LLM (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# AWS Credentials (Optional, for Infrastructure Cost Explorer analysis)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_DEFAULT_REGION=us-east-1
